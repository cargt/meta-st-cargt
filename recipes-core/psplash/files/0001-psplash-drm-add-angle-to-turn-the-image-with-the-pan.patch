From: Tim Carney <tim.carney@cargt.com>
Date: Thu, 29 Oct 2026 00:00:00 +0000
Subject: [PATCH] psplash-drm: add --angle to turn the image with the panel

psplash-drm draws straight into the panel's native scanout buffer, so on a
panel that Weston turns with an [output] transform the image comes out on
its side. --angle 90/180/270 turns the loaded image clockwise before it is
centred, like oe-core psplash's --angle.

Upstream-Status: Inappropriate [Cargt specific]
Signed-off-by: Tim Carney <tim.carney@cargt.com>
---
--- a/basic_splash_drm.c
+++ b/basic_splash_drm.c
@@ -46,6 +46,7 @@
 static int display_max_size = MAX_HEIGHT_THRESHOLD;
 static int force_hdmi = 0;
 static int force_no_hdmi = 0;
+static int angle = 0;
 volatile int loop = 0;
 //----------------------
 // Prototype
@@ -844,6 +845,46 @@
 }
 
 
+/*
+ * Turn an image clockwise by 90, 180 or 270 degrees, for a panel mounted
+ * rotated (as Weston's [output] transform does). Returns the new image and
+ * releases the old one; returns the old one if the angle isn't a turn.
+ */
+static pixman_image_t *rotate_image(pixman_image_t *src, int deg)
+{
+    int w = pixman_image_get_width(src);
+    int h = pixman_image_get_height(src);
+    int sstride = pixman_image_get_stride(src) / 4;
+    uint32_t *s = (uint32_t *)pixman_image_get_data(src);
+    int rw = (deg == 90 || deg == 270) ? h : w;
+    int rh = (deg == 90 || deg == 270) ? w : h;
+    pixman_image_t *dst;
+    uint32_t *d;
+    int x, y;
+
+    if (deg != 90 && deg != 180 && deg != 270)
+        return src;
+
+    dst = pixman_image_create_bits(pixman_image_get_format(src), rw, rh, NULL, rw * 4);
+    if (!dst)
+        return src;
+    d = (uint32_t *)pixman_image_get_data(dst);
+
+    for (y = 0; y < h; y++) {
+        for (x = 0; x < w; x++) {
+            uint32_t p = s[y * sstride + x];
+            if (deg == 90)
+                d[x * rw + (h - 1 - y)] = p;
+            else if (deg == 180)
+                d[(h - 1 - y) * rw + (w - 1 - x)] = p;
+            else
+                d[(w - 1 - x) * rw + y] = p;
+        }
+    }
+    pixman_image_unref(src);
+    return dst;
+}
+
 int
 draw_frame(struct modeset_dev *dev, const char *filename)
 {
