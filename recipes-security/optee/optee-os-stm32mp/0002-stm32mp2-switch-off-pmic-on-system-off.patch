From 504dfe4c096c83dd35a52c00027c854b474614b8 Mon Sep 17 00:00:00 2001
From: Graham Taylor-Jones <graham.taylor-jones@cargt.com>
Date: Wed, 30 Sep 2026 07:39:36 -0500
Subject: [PATCH] stm32mp2: switch off PMIC on system off

poweroff currently only asks the SoC PWR block to collapse power
domains and blocks on wfi(), trusting an unconfirmed PWR<->STPMIC2
hardware handshake to actually remove power. IWDG1 (32s hardware
timeout) is fed only twice, very early in boot, and never again -
if that handshake ever takes too long, IWDG1 can fire mid-shutdown
and reset the board, which looks like a spontaneous reboot instead
of a power-off.

A prior attempt fixed this from TF-A's BL31 by calling the
already-compiled-but-unused stpmic2_switch_off()/pmic_switch_off()
(the same STPMIC2 MAIN_CR.SWOFF helper stm32mp1 already uses)
directly from stm32_system_off(). That was wrong: on this board
I2C7 (the PMIC bus) is RIF-locked to OP-TEE's CID
(stm32mp257f-cargt-00395-*-00365-rif.dtsi: RIFPROT(...I2C7_ID...,
RIF_CID1...)), so BL31 has no legitimate access to it. Confirmed
on hardware: that BL31-side fix reproduced the exact same
IWDG-reset bug intermittently, almost certainly from BL31 racing
OP-TEE's ownership of the bus.

TF-A's generic psci_system_off() already notifies OP-TEE first via
the standard SPD hook (opteed_system_off() -> this platform's
thread_system_off_handler(), core/arch/arm/plat-stm32mp2/stm32mp_pm.c)
before calling the platform's own stm32_system_off() - so OP-TEE,
which legitimately owns I2C7, is the right place for this. Its
existing handler only called the generic pm_change_state() (a
clock/power-level hint) and never actually asked the PMIC to cut
power.

Add stpmic2_switch_off() to OP-TEE's own STPMIC2 driver, mirroring
TF-A's stm32mp1 helper (same MAIN_CR.SWOFF register write), and
call it from thread_system_off_handler() via a small
stm32_stpmic2_switch_off() wrapper that reuses the driver's
already-initialized PMIC handle (the same one IRQ handling uses).

Signed-off-by: Graham Taylor-Jones <graham.taylor-jones@cargt.com>
---
 core/arch/arm/plat-stm32mp2/stm32_util.h  | 13 +++++++++++++
 core/arch/arm/plat-stm32mp2/stm32mp_pm.c  | 18 +++++++++++++++-
 core/drivers/stm32mp_pmic2.c              | 13 +++++++++++++
 core/drivers/stpmic2.c                    |  5 +++++
 core/include/drivers/stpmic2.h            |  5 +++++
 5 files changed, 53 insertions(+), 1 deletion(-)

diff --git a/core/include/drivers/stpmic2.h b/core/include/drivers/stpmic2.h
index a10607bcd..781169a43 100644
--- a/core/include/drivers/stpmic2.h
+++ b/core/include/drivers/stpmic2.h
@@ -188,6 +188,9 @@
 #define MAJOR_VERSION_MASK	GENMASK_32(7, 4)
 #define MAJOR_VERSION_SHIFT	4
 
+/* MAIN_CR bits definition */
+#define SWOFF			BIT(0)
+
 /* BUCKS_MRST_CR bits definition */
 #define BUCK1_MRST		BIT(0)
 #define BUCK2_MRST		BIT(1)
@@ -338,6 +341,8 @@
 TEE_Result stpmic2_register_update(struct stpmic2 *pmic, uint8_t register_id,
 				   uint8_t value, uint8_t mask);
 
+TEE_Result stpmic2_switch_off(struct stpmic2 *pmic);
+
 TEE_Result stpmic2_regulator_set_state(struct stpmic2 *pmic, uint8_t id,
 				       bool enable);
 TEE_Result stpmic2_regulator_get_state(struct stpmic2 *pmic, uint8_t id,
diff --git a/core/drivers/stpmic2.c b/core/drivers/stpmic2.c
index 9f06b708b..a75c8d031 100644
--- a/core/drivers/stpmic2.c
+++ b/core/drivers/stpmic2.c
@@ -298,6 +298,11 @@
 	return stpmic2_register_write(pmic, register_id, val);
 }
 
+TEE_Result stpmic2_switch_off(struct stpmic2 *pmic)
+{
+	return stpmic2_register_update(pmic, MAIN_CR, SWOFF, SWOFF);
+}
+
 TEE_Result stpmic2_regulator_set_state(struct stpmic2 *pmic, uint8_t id,
 				       bool enable)
 {
diff --git a/core/drivers/stm32mp_pmic2.c b/core/drivers/stm32mp_pmic2.c
index aa1294924..46a4a7ee0 100644
--- a/core/drivers/stm32mp_pmic2.c
+++ b/core/drivers/stm32mp_pmic2.c
@@ -856,6 +856,19 @@
 
 	return TEE_SUCCESS;
 }
+
+TEE_Result stm32_stpmic2_switch_off(void)
+{
+	if (!stpmic2)
+		return TEE_ERROR_NOT_SUPPORTED;
+
+	return stpmic2_switch_off(stpmic2);
+}
+#else
+TEE_Result stm32_stpmic2_switch_off(void)
+{
+	return TEE_ERROR_NOT_SUPPORTED;
+}
 #endif
 
 static void initialize_pmic2_i2c(const void *fdt, int node,
diff --git a/core/arch/arm/plat-stm32mp2/stm32_util.h b/core/arch/arm/plat-stm32mp2/stm32_util.h
index cda6c7826..c219abd27 100644
--- a/core/arch/arm/plat-stm32mp2/stm32_util.h
+++ b/core/arch/arm/plat-stm32mp2/stm32_util.h
@@ -9,6 +9,7 @@
 #include <drivers/stm32mp2_rcc_util.h>
 #include <kernel/spinlock.h>
 #include <stdint.h>
+#include <tee_api_types.h>
 #include <types_ext.h>
 
 #define may_spin_lock(lock)		  cpu_spin_lock_xsave(lock)
@@ -23,11 +24,17 @@
 
 #ifdef CFG_STPMIC2
 bool stm32_stpmic2_is_present(void);
+TEE_Result stm32_stpmic2_switch_off(void);
 #else
 static inline bool stm32_stpmic2_is_present(void)
 {
 	return false;
 }
+
+static inline TEE_Result stm32_stpmic2_switch_off(void)
+{
+	return TEE_ERROR_NOT_SUPPORTED;
+}
 #endif
 
 void stm32_debug_suspend(unsigned long a0);
diff --git a/core/arch/arm/plat-stm32mp2/stm32mp_pm.c b/core/arch/arm/plat-stm32mp2/stm32mp_pm.c
index 8822eefa7..d312b3237 100644
--- a/core/arch/arm/plat-stm32mp2/stm32mp_pm.c
+++ b/core/arch/arm/plat-stm32mp2/stm32mp_pm.c
@@ -9,6 +9,7 @@
 #include <sm/psci.h>
 #include <stm32mp_pm.h>
 #include <stm32_util.h>
+#include <trace.h>
 
 /**
  * @brief   Handler for system off
@@ -28,8 +29,23 @@
 	uint32_t pm_hint = PM_HINT_CLOCK_STATE |
 		((PM_MAX_LEVEL << PM_HINT_PLATFORM_STATE_SHIFT) &
 		  PM_HINT_PLATFORM_STATE_MASK);
+	TEE_Result res = TEE_ERROR_GENERIC;
 
-	return pm_change_state(PM_OP_SUSPEND, pm_hint);
+	res = pm_change_state(PM_OP_SUSPEND, pm_hint);
+	if (res)
+		EMSG("pm_change_state(SUSPEND) failed: %#"PRIx32, res);
+
+	/*
+	 * Physically cut power via STPMIC2 MAIN_CR.SWOFF. I2C7 (the PMIC
+	 * bus) is RIF-locked to OP-TEE's CID, so this must happen here
+	 * rather than in TF-A's platform system_off hook, which has no
+	 * legitimate access to it.
+	 */
+	res = stm32_stpmic2_switch_off();
+	if (res)
+		EMSG("STPMIC2 switch off failed: %#"PRIx32, res);
+
+	return res;
 }
 
 static uint32_t get_pm_hint(unsigned long a0)
--
2.43.0
