# See docs/rauc-ota-updates.md for how to stand up your own hawkBit server
# and register this target to get hawkbit_server/auth_token values for it.
[client]
hawkbit_server            = REPLACE_WITH_YOUR_HAWKBIT_SERVER_IP:8083
ssl                       = false
ssl_verify                = false
tenant_id                 = DEFAULT
target_name               = stm32mp25-cargt-00395-01-00365
auth_token                = REPLACE_WITH_YOUR_TARGET_SECURITY_TOKEN
bundle_download_location  = /usr/local/rauc-hawkbit/bundle.raucb
retry_wait                = 60
connect_timeout           = 20
timeout                   = 60
low_speed_time            = 0
low_speed_rate            = 0
post_update_reboot        = true
log_level                 = message

[device]
model                     = stm32mp25-cargt-00395-01-00365
