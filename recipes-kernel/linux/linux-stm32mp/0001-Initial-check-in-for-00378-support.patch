+	/*
+	 * External SoC PTA signalling mode
+	 * 
+	 * 00 - Reserved
+	 * 01 - 1-wire
+	 * 02 - 2-wires
+	 * 11 - 3-wires
+	 */
+	uint8_t ext_soc_pta_signalling_mode;
+	/* 
+	 * External SoC request polarity
+	 * 
+	 * 0 - Active Low (Default)
+	 *
+	 * 1 - Active High
+	 */
+	uint8_t ext_soc_request_polarity;
+	/* 
+	 * External SoC priority polarity
+	 *
+	 * 0 - Active Low (Default)
