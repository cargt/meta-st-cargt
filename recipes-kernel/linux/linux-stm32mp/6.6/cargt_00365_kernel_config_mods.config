# CONFIG_LOGO is not set
CONFIG_RTC_DRV_RV3032=y
CONFIG_DRM_TI_SN65DSI83=y

CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO=y
# CONFIG_DEBUG_INFO_REDUCED is not set

# Add support for 2.8" SPI display (GLT028240320IS1-CTP)
CONFIG_TINYDRM_ST7789T3=y

# Add support for 5.5" MIPI DSI display (GLT0557201280IS1-CTP)
CONFIG_TOUCHSCREEN_ILITEK=y
CONFIG_DRM_PANEL_ILITEK_ILI9881C=y

# Build the DSI panel's display path into the kernel so the panel (and the
# boot splash) is up before userspace, not ~12 s in once udev has loaded
# the modules. The panel also waits on its reset GPIO (a PCA9555 on I2C)
# and its PWM backlight, so those drivers come in too.
CONFIG_DRM_STM_DSI=y
CONFIG_DRM_DW_MIPI_DSI=y
CONFIG_I2C_STM32F7=y
CONFIG_MFD_STM32_TIMERS=y
CONFIG_PWM_STM32=y
CONFIG_BACKLIGHT_PWM=y
