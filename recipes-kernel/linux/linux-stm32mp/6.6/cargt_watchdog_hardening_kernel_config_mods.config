# Localized in-kernel deadlocks (one lock held forever by a task that's
# killed mid-critical-section, e.g. by an unrelated driver bug taking a
# fault) are invisible to the hardware watchdog: once systemd has opened
# /dev/watchdog and is feeding it from its own main event loop, that loop
# doesn't need whatever got stuck, so it keeps petting the watchdog
# forever while some other, unrelated part of the kernel silently wedges.
# Confirmed on hardware: a Bluetooth driver bug (see the btnxpuart patch)
# left kworkers piling up in D-state for the rest of the system's uptime,
# fully reachable over the network/SSH auth, but unable to fork any new
# process - with no automatic recovery and no way to tell from the
# outside without a live serial console.
#
# CONFIG_DETECT_HUNG_TASK + CONFIG_BOOTPARAM_HUNG_TASK_PANIC closes this
# gap: once a task has been stuck in uninterruptible ("D") state for
# longer than the timeout below, the kernel panics - which *does* stop
# systemd's watchdog-feeding loop too, letting the already-armed hardware
# watchdog fire and actually recover the board.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y

# The default timeout (120s) is too short for this BSP: a fresh board's
# very first boot can legitimately block a userspace process in D-state
# for several minutes doing a one-time full bad-blocks e2fsck scan of
# userfs (see the resize-helper/init-resize.sh patches) before that
# scenario was fixed to only ever happen once. Use a longer timeout with
# real margin over that, rather than risk panicking mid-scan on an
# otherwise-healthy first boot - a wedge that self-recovers within ten
# minutes is still a large improvement over one that never recovers at
# all.
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=600

# Workqueue stall detection: purely diagnostic (dmesg only, no panic
# capability of its own - see kernel/workqueue.c's wq_watchdog_timer_fn),
# but it's the more precisely-targeted detector for exactly the failure
# mode observed (a stuck kworker, not a normal blocking userspace
# syscall), and gives a workqueue-state dump in the log that
# CONFIG_DETECT_HUNG_TASK's generic stack trace alone would not.
CONFIG_WQ_WATCHDOG=y
