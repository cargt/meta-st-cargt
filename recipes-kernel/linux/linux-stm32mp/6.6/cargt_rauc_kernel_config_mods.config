CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_NBD=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y

# By default, arm_smc_wdt's probe (drivers/watchdog/arm_smc_wdt.c) detects
# that U-Boot already armed the hardware watchdog and sets WDOG_HW_RUNNING,
# which makes the kernel's generic watchdog core auto-feed it in-kernel
# (independent of userspace) until systemd opens /dev/watchdog and takes
# real ownership. A hang in the initrd - before systemd ever starts, e.g.
# root= pointing at a nonexistent partition - is therefore invisible to the
# watchdog indefinitely: the kernel just keeps feeding it through the hang.
# Rollback safety (see docs/rauc-ota-updates.md 2.5) depends on exactly
# this class of early-boot hang actually resetting the board so U-Boot's
# own bootcount mechanism gets another attempt - so disable the auto-feed
# and let a hung early boot fall through to the hardware's own timeout.
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set
